{
	"version": 3,
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"dimensions": {
			"minHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"units": ["rem"],
			"blockGap": true
		},
		"shadow": {
			"presets": [
				{
					"name": "Small",
					"slug": "sm",
					"shadow": "0 1px 5px 0 rgba(0, 0, 0, 0.1)"
				},
				{
					"name": "Medium",
					"slug": "md",
					"shadow": "0 3px 7px 0 rgba(0, 0, 0, 0.1)"
				},
				{
					"name": "Large",
					"slug": "lg",
					"shadow": "0 25px 50px -12px rgba(0, 0, 0, 0.25);"
				}
			]
		},
		"color": {
			"defaultPalette": false
		},
		"layout": {
			"contentSize": "calc(1440px - 2rem)",
			"wideSize": "1440px"
		},

		"typography": {
			"fluid": true,
			"letterSpacing": true,
			"lineHeight": true,
			"fontFamilies": [
				{
					"fontFamily": "Exo 2",
					"slug": "exo-2",
					"name": "Exo 2",
					"fontFace": [
						{
							"fontFamily": "Exo 2",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": ["file:./assets/fonts/Exo2-Regular.woff2"]
						},
						{
							"fontFamily": "Exo 2",
							"fontWeight": "200",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": ["file:./assets/fonts/Exo2-ExtraLight.woff2"]
						},
						{
							"fontFamily": "Exo 2",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": ["file:./assets/fonts/Exo2-SemiBold.woff2"]
						},

						{
							"fontFamily": "Exo 2",
							"fontWeight": "400",
							"fontStyle": "italic",
							"fontStretch": "normal",
							"src": ["file:./assets/fonts/Exo2-Italic.woff2"]
						},
						{
							"fontFamily": "Exo 2",
							"fontWeight": "200",
							"fontStyle": "italic",
							"fontStretch": "normal",
							"src": ["file:./assets/fonts/Exo2-ExtraLightItalic.woff2"]
						},
						{
							"fontFamily": "Exo 2",
							"fontWeight": "600",
							"fontStyle": "italic",
							"fontStretch": "normal",
							"src": ["file:./assets/fonts/Exo2-SemiBoldItalic.woff2"]
						}
					]
				},
				{
					"fontFamily": "Fuzzy Bubbles",
					"slug": "fuzzy-bubbles",
					"name": "Fuzzy Bubbles",
					"fontFace": [
						{
							"fontFamily": "Fuzzy Bubbles",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": ["file:./assets/fonts/fuzzy-bubbles-regular.woff2"]
						},
						{
							"fontFamily": "Fuzzy Bubbles",
							"fontWeight": "bold",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": ["file:./assets/fonts/fuzzy-bubbles-bold.woff2"]
						}
					]
				},
				{
					"fontFamily": "Gochi Hand",
					"slug": "gochi-hand",
					"name": "Gochi Hand",
					"fontFace": [
						{
							"fontFamily": "Gochi Hand",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": ["file:./assets/fonts/gochi-hand-v14-latin-regular.woff2"]
						}
					]
				}
			]
		},
		"blocks": {
			"core/blockquote": {
				"border": {
					"style": true
				}
			},
			"core/column": {
				"spacing": {
					"units": ["%"]
				}
			}
		},
		"custom": {
			"ctxForms": {
				"field": {
					"activeColor": "var(--wp--custom--ctx--ui--field--active-color)",
					"focusRing": "var(--wp--custom--ctx--ui--focus-ring)",
					"boxShadow": "var(--wp--custom--ctx--ui--field--box-shadow)",
					"radius": "var(--wp--custom--ctx--ui--field--radius)",
					"fontSize": "var(--wp--custom--ctx--ui--font-size)"
				},
				"button": {
					"radius": "var(--wp--custom--ctx--ui--button--radius)",
					"paddingX": "var(--wp--custom--ctx--ui--button--padding-x)",
					"disabledOpacity": "var(--wp--custom--ctx--ui--button--disabled-opacity)"
				},
				"accordion": {
					"sectionRadius": "var(--wp--custom--ctx--ui--accordion--radius)",
					"sectionBorder": "none",
					"sectionShadow": "var(--wp--custom--ctx--ui--accordion--shadow)",
					"headerPadding": "var(--wp--custom--ctx--ui--accordion--header-padding-y) var(--wp--custom--ctx--ui--accordion--header-padding-x)",
					"contentPadding": "var(--wp--custom--ctx--ui--accordion--content-padding)"
				}
			},
			"ctxEvents": {
				"booking": {
					"attendeeAccent": "var(--wp--preset--color--primary)"
				},
				"details": {
					"iconRadius": "999px"
				}
			},
			"ctx": {
				"card": {
					"radius": "1rem",
					"padding": {
						"top": "1rem",
						"bottom": "1rem",
						"left": "1rem",
						"right": "1rem"
					}
				},
				"ui": {
					"color": "#000000",
					"onColor": "#ffffff",
					"radius": "99px",
					"fontSize": "1rem",
					"paddingY": "0.84rem",
					"borderWidth": "2px",
					"shadow": "0 10px 15px -3px rgba(0, 0, 0, 0.1)",
					"focusRing": "0 0 0 3px var(--primary-ultralight) !important",
					"field": {
						"background": "#ffffff",
						"textColor": "var(--wp--preset--color--text)",
						"borderColor": "rgba(0, 0, 0, 0.15)",
						"hoverBackground": "rgba(0, 0, 0, 0.03)",
						"activeColor": "#0bb9e6",
						"mutedColor": "rgba(0, 0, 0, 0.6)",
						"successColor": "#1a7f37",
						"boxShadow": "0 10px 15px -3px rgba(0, 0, 0, 0.1)",
						"radius": "0rem"
					},
					"button": {
						"paddingX": "1.25rem",
						"radius": "999px",
						"disabledOpacity": "0.55",
						"fontWeight": "600"
					},
					"accordion": {
						"radius": "0rem",
						"shadow": "0 10px 15px -3px rgba(0, 0, 0, 0.1)",
						"gap": "1rem",
						"headerPaddingY": "1rem",
						"headerPaddingX": "1.25rem",
						"contentPadding": "1.25rem"
					},
					"dialog": {
						"radius": "0.75rem",
						"padding": "1.5rem",
						"shadow": "0 1.5rem 3rem rgb(0 0 0 / 0.22)",
						"backdrop": "rgb(0 0 0 / 0.55)",
						"maxWidth": "42rem"
					},
					"stepper": {
						"radius": "999px",
						"padding": "3px",
						"gap": "0.5rem",
						"buttonSize": "1.75rem",
						"buttonRadius": "999px",
						"buttonBackground": "var(--wp--custom--ctx--ui--field--background)",
						"buttonTextColor": "var(--wp--custom--ctx--ui--field--text-color)",
						"buttonBorderColor": "var(--wp--custom--ctx--ui--field--border-color)",
						"buttonHoverBackground": "var(--wp--custom--ctx--ui--field--hover-background)",
						"valueMinWidth": "1.75rem",
						"disabledOpacity": "0.55",
						"focusRing": "var(--wp--custom--ctx--ui--focus-ring)"
					},
					"range": {
						"controlHeight": "1.5rem",
						"trackHeight": "0.375rem",
						"trackRadius": "999px",
						"trackBackground": "var(--wp--custom--ctx--ui--field--hover-background)",
						"indicatorBackground": "var(--wp--custom--ctx--ui--field--active-color)",
						"thumbSize": "1rem",
						"thumbRadius": "999px",
						"thumbBorder": "2px solid var(--wp--custom--ctx--ui--field--active-color)",
						"thumbBackground": "var(--wp--custom--ctx--ui--field--background)",
						"thumbShadow": "var(--wp--custom--ctx--ui--field--box-shadow)"
					}
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "#f4f4f4",
			"text": "var(--wp--preset--color--text)"
		},
		"spacing": {
			"margin": {
				"bottom": "60px"
			},
			"padding": {
				"left": "1rem",
				"right": "1rem",
				"bottom": "2rem"
			}
		},
		"elements": {
			"link": {
				"typography": {
					"textDecoration": "none"
				}
			}
		},
		"blocks": {
			"core/heading": {
				"typography": {
					"fontWeight": "600"
				}
			},
			"core/paragraph": {
				"typography": {
					"lineHeight": "1.7"
				}
			},
			"core/column": {
				"spacing": {}
			},
			"ctx-blocks/card": {
				"variations": {
					"dotted": {
						"border": {
							"style": "dotted",
							"width": "4px",
							"color": "#3e3e3f"
						}
					}
				}
			},
			"core/navigation-link": {
				"typography": {
					"fontWeight": "600"
				}
			},
			"core/navigation-submenu": {
				"typography": {
					"fontWeight": "600"
				}
			},
			"events-manager/booking": {
				"border": {
					"radius": {
						"topLeft": ".75rem",
						"topRight": "0",
						"bottomLeft": "0",
						"bottomRight": ".75rem"
					}
				},
				"spacing": {
					"padding": {
						"top": "0.6rem",
						"bottom": "0.6rem",
						"left": "1rem",
						"right": "1rem"
					},
					"blockGap": "var(--wp--preset--spacing--50)"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "#ffffff"
				}
			},
			"ctx-blocks/grid-row": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--50)"
				}
			},
			"ctx-blocks/description-item": {
				"border": {
					"radius": "999px"
				}
			}
		},
		"typography": {
			"fontFamily": "\"Exo 2\", sans-serif"
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Navigation",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "noheader",
			"title": "Page without header",
			"postTypes": ["page", "post"]
		},
		{
			"name": "empty",
			"title": "Empty Page (no header, no footer)",
			"postTypes": ["page", "post"]
		},
		{
			"name": "single-ctx-event",
			"title": "Single Event",
			"postTypes": ["ctx-event"]
		}
	]
}
